# Copy to .env and fill in. .env is gitignored — never commit your key.

# Anthropic API key (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# Scaleway Generative APIs secret key (console.scaleway.com → IAM → API keys), for the
# open-weight models. Optional: without it only the Claude models can be selected.
SCW_SECRET_KEY=REPLACE-ME

# Path to the GLOBALISE Word2Vec model (plain-text word2vec format)
WORD2VEC_PATH=/path/to/GLOBALISE_100.word2vec

# Optional
# LLM_MODEL=claude-opus-5-5   # default model on the page (see MODELS in agent.py)
# LLM_EFFORT=medium           # overrides effort for the Claude models: low | medium | high | xhigh | max
# PORT=5055
